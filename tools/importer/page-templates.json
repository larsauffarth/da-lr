{
  "templates": [
    {
      "name": "rossmann-homepage",
      "urls": ["https://unternehmen.rossmann.de/"],
      "description": "Rossmann corporate homepage with hero banner, company introduction, press releases/news cards, sustainability teaser, two-column brand teasers, video embed, and new stores CTA",
      "blocks": [
        {
          "name": "hero-corporate",
          "instances": [".content-header"]
        },
        {
          "name": "cards-news",
          "instances": ["#c697.content-press-releases"]
        },
        {
          "name": "columns-teaser",
          "instances": [
            "#c370.content-teaser",
            "#c360.content-teaser",
            "#c690.content-text.bg-intensivrot"
          ]
        }
      ]
    },
    {
      "name": "deka-privatkunden-homepage",
      "urls": ["https://www.deka.de/privatkunden"],
      "description": "Deka Investments Privatkunden homepage with hero stage, online banking announcement, news/article cards, product offering cards, info banner columns, newsletter CTA, and award cards",
      "blocks": [
        {
          "name": "hero-deka",
          "instances": ["section.hero-stage"]
        },
        {
          "name": "cards-deka",
          "instances": [
            "section.grid:has(.p-tag-label):has(.hauptthema__date)",
            "section.grid:has(.p-tag-label):has(.auszeichnung)"
          ],
          "section": "News and award card grids"
        },
        {
          "name": "cards-deka-product",
          "instances": [
            "section.grid:has(.angebots-kachel)"
          ],
          "section": "Product offering card grid"
        },
        {
          "name": "columns-deka",
          "instances": [
            "section.grid:has(.infobereich)"
          ],
          "section": "50/50 text and image info banner"
        }
      ]
    }
  ]
}
